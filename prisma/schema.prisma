// QR Tanki Database Schema
// Comprehensive water tank cleaning management system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles for the system
enum UserRole {
  USER
  CLEANER
  ADMIN
}

// Subscription plans
enum SubscriptionPlan {
  BASIC
  PREMIUM
  NONE
}

// Cleaning types
enum CleaningType {
  BASIC
  DEEP
  EMERGENCY
}

// Payment status
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Task status
enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Main user model with role-based access
model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  phone             String?
  role              UserRole @default(USER)
  avatar            String?
  isVerified        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  tanks             Tank[]
  subscriptions     Subscription[]
  cleaningRequests  CleaningRequest[]
  feedbacks         Feedback[]
  payments          Payment[]
  cleaner           Cleaner?
  wallet            Wallet?
  groupMembers      GroupMember[]
  emergencyRequests EmergencyRequest[]
  packageBookings   PackageBooking[]
  traineeEnrollments TraineeEnrollment[]
  tankInsurances    TankInsurance[]
  insuranceClaims   InsuranceClaim[]
  userRewards       UserReward[]
  healthCertifications HealthCertification[]
  certificationRequests CertificationRequest[]

  @@map("users")
}

// Cleaner profile
model Cleaner {
  id                String   @id @default(cuid())
  userId            String   @unique
  experience        String?
  serviceArea       String?
  rating            Float?   @default(0)
  totalJobs         Int      @default(0)
  isAvailable       Boolean  @default(true)
  bio               String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id])
  cleaningRecords   CleaningRecord[]
  earnings          Earning[]
  cleaningRequests  CleaningRequest[]
  emergencyRequests EmergencyRequest[]

  @@map("cleaners")
}

// Tank information
model Tank {
  id                String   @id @default(cuid())
  userId            String
  qrCodeId          String   @unique
  name              String
  type              String
  capacity          String?
  location          String
  installationDate  DateTime?
  lastCleanedDate   DateTime?
  nextDueDate       DateTime?
  hygieneScore      Float?   @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id])
  qrCode            QRCode   @relation(fields: [qrCodeId], references: [id])
  cleaningRecords   CleaningRecord[]
  cleaningRequests  CleaningRequest[]
  tankInsurance     TankInsurance?
  emergencyRequests EmergencyRequest[]
  packageBookings   PackageBooking[]
  healthCertifications HealthCertification[]
  certificationRequests CertificationRequest[]

  @@map("tanks")
}

// QR Code
model QRCode {
  id                String   @id @default(cuid())
  code              String   @unique
  tankId            String?  @unique
  isGenerated       Boolean  @default(false)
  isPaid            Boolean  @default(false)
  paymentId         String?  @unique
  generatedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tank              Tank?
  payment           Payment? @relation(fields: [paymentId], references: [id])

  @@map("qr_codes")
}

// Subscription
model Subscription {
  id                String           @id @default(cuid())
  userId            String
  plan              SubscriptionPlan
  amount            Float
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean          @default(true)
  autoRenew         Boolean          @default(false)
  cleaningFrequency Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user              User             @relation(fields: [userId], references: [id])
  payments          Payment[]

  @@map("subscriptions")
}

// Cleaning requests
model CleaningRequest {
  id                String       @id @default(cuid())
  userId            String
  tankId            String
  cleanerId         String?
  groupBookingId    String?
  cleaningType      CleaningType
  requestedDate     DateTime
  scheduledDate     DateTime?
  preferredTime     String?
  notes             String?
  status            TaskStatus   @default(PENDING)
  urgencyLevel      Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User         @relation(fields: [userId], references: [id])
  tank              Tank         @relation(fields: [tankId], references: [id])
  cleaner           Cleaner?     @relation(fields: [cleanerId], references: [id])
  cleaningRecord    CleaningRecord?
  payment           Payment?
  groupBooking      GroupBooking? @relation(fields: [groupBookingId], references: [id])

  @@map("cleaning_requests")
}

// Cleaning records
model CleaningRecord {
  id                String       @id @default(cuid())
  tankId            String
  cleanerId         String
  requestId         String?      @unique
  cleaningType      CleaningType
  cleanedAt         DateTime
  duration          Int?
  beforePhotos      String?
  afterPhotos       String?
  notes             String?
  hygieneScore      Float?       @default(0)
  isVerified        Boolean      @default(false)
  verifiedBy        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tank              Tank         @relation(fields: [tankId], references: [id])
  cleaner           Cleaner      @relation(fields: [cleanerId], references: [id])
  request           CleaningRequest? @relation(fields: [requestId], references: [id])
  feedbacks         Feedback[]
  packageBooking    PackageBooking?
  emergencyRequests EmergencyRequest[]

  @@map("cleaning_records")
}

// Payment
model Payment {
  id                String         @id @default(cuid())
  userId            String
  subscriptionId    String?
  qrCodeId          String?        @unique
  requestId         String?        @unique
  groupBookingId    String?
  packageBookingId  String?        @unique
  amount            Float
  type              String
  status            PaymentStatus  @default(PENDING)
  paymentMethod     String?
  transactionId     String?        @unique
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user              User           @relation(fields: [userId], references: [id])
  subscription      Subscription?  @relation(fields: [subscriptionId], references: [id])
  qrCode            QRCode?
  request           CleaningRequest? @relation(fields: [requestId], references: [id])
  groupBooking      GroupBooking?  @relation(fields: [groupBookingId], references: [id])
  packageBooking    PackageBooking?
  emergencyRequests EmergencyRequest[]

  @@map("payments")
}

// Earning
model Earning {
  id                String   @id @default(cuid())
  cleanerId         String
  requestId         String?
  amount            Float
  commission        Float
  netAmount         Float
  earnedAt          DateTime
  isPaid            Boolean  @default(false)
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cleaner           Cleaner  @relation(fields: [cleanerId], references: [id])

  @@map("earnings")
}

// Feedback
model Feedback {
  id                String   @id @default(cuid())
  userId            String
  cleaningRecordId  String
  cleanerId         String?
  rating            Int
  comment           String?
  isPublic          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id])
  cleaningRecord    CleaningRecord @relation(fields: [cleaningRecordId], references: [id])

  @@map("feedbacks")
}

// Notifications
model Notification {
  id                String   @id @default(cuid())
  userId            String?
  title             String
  message           String
  type              String
  isRead            Boolean  @default(false)
  actionUrl         String?
  createdAt         DateTime @default(now())

  @@map("notifications")
}

// Group Booking
model GroupBooking {
  id                String   @id @default(cuid())
  societyName       String
  contactPerson     String
  contactPhone      String
  contactEmail      String
  address           String
  totalTanks        Int
  discountRate      Float    @default(0.1)
  basePrice         Float
  discountedPrice   Float
  status            String   @default("PENDING")
  scheduledDate     DateTime?
  preferredTime     String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  groupMembers      GroupMember[]
  payments          Payment[]
  cleaningRequests  CleaningRequest[]

  @@map("group_bookings")
}

// Group members
model GroupMember {
  id                String   @id @default(cuid())
  groupBookingId    String
  userId            String
  tankName          String
  tankType          String
  tankCapacity      String?
  tankLocation      String
  isPrimaryContact  Boolean  @default(false)
  createdAt         DateTime @default(now())

  groupBooking      GroupBooking @relation(fields: [groupBookingId], references: [id])
  user              User         @relation(fields: [userId], references: [id])

  @@unique([groupBookingId, userId])
  @@map("group_members")
}

// Emergency requests
model EmergencyRequest {
  id                String   @id @default(cuid())
  userId            String
  tankId            String?
  contactName       String
  contactPhone      String
  contactEmail      String
  address           String
  urgencyLevel      String   @default("HIGH")
  issueDescription  String
  requestedAt       DateTime @default(now())
  respondedAt       DateTime?
  assignedCleanerId String?
  estimatedArrival  DateTime?
  status            String   @default("REQUESTED")
  priorityFee       Float    @default(0)
  totalCost         Float
  cleaningRecordId  String?
  paymentId         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id])
  tank              Tank?    @relation(fields: [tankId], references: [id])
  assignedCleaner   Cleaner? @relation(fields: [assignedCleanerId], references: [id])
  cleaningRecord    CleaningRecord? @relation(fields: [cleaningRecordId], references: [id])
  payment           Payment? @relation(fields: [paymentId], references: [id])

  @@map("emergency_requests")
}

// Custom packages
model CustomPackage {
  id                String   @id @default(cuid())
  name              String
  description       String
  basePrice         Float
  duration          String
  includedServices  String
  customizations    String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  packageBookings   PackageBooking[]

  @@map("custom_packages")
}

// Package bookings
model PackageBooking {
  id                String   @id @default(cuid())
  customPackageId   String
  userId            String
  tankId            String
  cleaningRecordId  String?  @unique
  paymentId         String?  @unique
  customizations    String?
  totalPrice        Float
  scheduledDate     DateTime?
  preferredTime     String?
  status            String   @default("PENDING")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customPackage     CustomPackage  @relation(fields: [customPackageId], references: [id])
  user              User           @relation(fields: [userId], references: [id])
  tank              Tank           @relation(fields: [tankId], references: [id])
  cleaningRecord    CleaningRecord? @relation(fields: [cleaningRecordId], references: [id])
  payment           Payment?  @relation(fields: [paymentId], references: [id])

  @@map("package_bookings")
}

// Training programs
model TrainingProgram {
  id                  String   @id @default(cuid())
  title               String
  description         String
  duration            String
  price               Float
  maxParticipants     Int
  currentParticipants Int      @default(0)
  startDate           DateTime?
  endDate             DateTime?
  location            String?
  instructor          String?
  curriculum          String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  enrollments         TraineeEnrollment[]
  certifications      Certification[]

  @@map("training_programs")
}

// Certifications
model Certification {
  id                String   @id @default(cuid())
  trainingProgramId String
  traineeId         String   @unique
  issuedAt          DateTime
  expiresAt         DateTime?
  certificateNumber String   @unique
  status            String   @default("ACTIVE")
  score             Int?
  createdAt         DateTime @default(now())

  trainingProgram   TrainingProgram   @relation(fields: [trainingProgramId], references: [id])
  trainee           TraineeEnrollment @relation(fields: [traineeId], references: [id])

  @@map("certifications")
}

// Trainee enrollments
model TraineeEnrollment {
  id                String   @id @default(cuid())
  trainingProgramId String
  traineeId         String
  userId            String
  enrolledAt        DateTime @default(now())
  completedAt       DateTime?
  status            String   @default("ENROLLED")
  progress          Float    @default(0)
  paymentStatus     String   @default("PENDING")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trainingProgram   TrainingProgram @relation(fields: [trainingProgramId], references: [id])
  certification     Certification?
  user              User            @relation(fields: [userId], references: [id])

  @@map("trainee_enrollments")
}

// Wallet
model Wallet {
  id                String   @id @default(cuid())
  userId            String   @unique
  balance           Float    @default(0)
  currency          String   @default("INR")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User         @relation(fields: [userId], references: [id])
  transactions      Transaction[]
  walletBalances    WalletBalance[]
  escrowAccounts    EscrowAccount[]

  @@map("wallets")
}

// Transactions
model Transaction {
  id                String   @id @default(cuid())
  walletId          String
  type              String
  amount            Float
  description       String?
  referenceId       String?
  referenceType     String?
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  wallet            Wallet @relation(fields: [walletId], references: [id])
  walletBalances    WalletBalance[]

  @@map("transactions")
}

// Wallet balance history
model WalletBalance {
  id                String   @id @default(cuid())
  walletId          String
  balance           Float
  transactionId     String?
  recordedAt        DateTime @default(now())

  wallet            Wallet       @relation(fields: [walletId], references: [id])
  transaction       Transaction? @relation(fields: [transactionId], references: [id])

  @@map("wallet_balances")
}

// Escrow
model EscrowAccount {
  id                String   @id @default(cuid())
  walletId          String
  bookingId         String?
  amount            Float
  status            String   @default("HELD")
  releasedAt        DateTime?
  refundedAt        DateTime?
  releaseReason     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  wallet            Wallet              @relation(fields: [walletId], references: [id])
  escrowTransactions EscrowTransaction[]

  @@map("escrow_accounts")
}

// Escrow transactions
model EscrowTransaction {
  id                String   @id @default(cuid())
  escrowAccountId   String
  type              String
  amount            Float
  description       String?
  createdAt         DateTime @default(now())

  escrowAccount     EscrowAccount @relation(fields: [escrowAccountId], references: [id])

  @@map("escrow_transactions")
}

// Tank insurance
model TankInsurance {
  id                String   @id @default(cuid())
  tankId            String   @unique
  userId            String
  policyNumber      String   @unique
  provider          String
  coverageType      String
  coverageAmount    Float
  premium           Float
  premiumFrequency  String
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean  @default(true)
  documents         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tank              Tank    @relation(fields: [tankId], references: [id])
  user              User    @relation(fields: [userId], references: [id])
  insuranceClaims   InsuranceClaim[]

  @@map("tank_insurances")
}

// Insurance claims
model InsuranceClaim {
  id                  String   @id @default(cuid())
  tankInsuranceId     String
  userId              String
  claimNumber         String   @unique
  incidentDate        DateTime
  incidentDescription String
  claimAmount         Float
  status              String   @default("SUBMITTED")
  documents           String?
  assessedAmount      Float?
  approvedAmount      Float?
  approvedAt          DateTime?
  paidAt              DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tankInsurance       TankInsurance @relation(fields: [tankInsuranceId], references: [id])
  user                User          @relation(fields: [userId], references: [id])

  @@map("insurance_claims")
}

// Loyalty program
model LoyaltyProgram {
  id                String   @id @default(cuid())
  name              String
  description       String
  pointsPerRupee    Float    @default(1)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  rewards           Reward[]
  userRewards       UserReward[]

  @@map("loyalty_programs")
}

// Rewards
model Reward {
  id                String   @id @default(cuid())
  loyaltyProgramId  String
  name              String
  description       String
  pointsRequired    Int
  rewardType        String
  rewardValue       Float
  isActive          Boolean  @default(true)
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  loyaltyProgram    LoyaltyProgram @relation(fields: [loyaltyProgramId], references: [id])
  userRewards       UserReward[]
  rewardRedemptions RewardRedemption[]

  @@map("rewards")
}

// User rewards
model UserReward {
  id                String   @id @default(cuid())
  userId            String
  loyaltyProgramId  String
  rewardId          String
  points            Int
  earnedAt          DateTime @default(now())
  expiresAt         DateTime?
  isRedeemed        Boolean  @default(false)
  redeemedAt        DateTime?
  createdAt         DateTime @default(now())

  user              User           @relation(fields: [userId], references: [id])
  loyaltyProgram    LoyaltyProgram @relation(fields: [loyaltyProgramId], references: [id])
  reward            Reward         @relation(fields: [rewardId], references: [id])
  rewardRedemption  RewardRedemption?

  @@map("user_rewards")
}

// Reward redemptions
model RewardRedemption {
  id                String   @id @default(cuid())
  userRewardId      String   @unique
  rewardId          String
  redeemedAt        DateTime @default(now())
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())

  userReward        UserReward @relation(fields: [userRewardId], references: [id])
  reward            Reward     @relation(fields: [rewardId], references: [id])

  @@map("reward_redemptions")
}

// Health certifications
model HealthCertification {
  id                String   @id @default(cuid())
  tankId            String
  userId            String
  certificationId   String?  @unique
  certificateNumber String   @unique
  issuedBy          String
  issuedAt          DateTime
  validUntil        DateTime
  hygieneScore      Float
  testResults       String?
  status            String   @default("ACTIVE")
  documents         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tank              Tank    @relation(fields: [tankId], references: [id])
  user              User    @relation(fields: [userId], references: [id])
  certificationRequests CertificationRequest[]

  @@map("health_certifications")
}

// Certification requests
model CertificationRequest {
  id                String   @id @default(cuid())
  tankId            String
  userId            String
  requestedAt       DateTime @default(now())
  status            String   @default("PENDING")
  completedAt       DateTime?
  certificateId     String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tank              Tank                @relation(fields: [tankId], references: [id])
  user              User                @relation(fields: [userId], references: [id])
  healthCertification HealthCertification? @relation(fields: [certificateId], references: [id])

  @@map("certification_requests")
}
